generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stat {
  id    String @id @default(uuid())
  value String
  label String
  order Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stats")
}

model NewsArticle {
  id                 String   @id @default(uuid())
  title              String
  summary            String
  imageUrl           String?  @map("image_url")
  date               DateTime
  readTimeMinutes    Int      @map("read_time_minutes")
  slug               String   @unique
  content            String?
  author             String?  @default("Equipo JEO")
  tags               String[] @default([])
  coverImageCaption  String?  @map("cover_image_caption")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news_articles")
}

model UniverseTab {
  id          String  @id @default(uuid())
  label       String
  slug        String  @unique
  description String?
  imageUrl    String? @map("image_url")
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("universe_tabs")
}

model Planet {
  id          String  @id @default(uuid())
  name        String  @unique
  imageUrl    String? @map("image_url")
  order       Int     @default(0)
  description String?
  slug        String  @unique

  moons Moon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("planets")
}

model Moon {
  id          String  @id @default(uuid())
  name        String
  imageUrl    String? @map("image_url")
  order       Int     @default(0)
  description String?
  slug        String  @unique

  planet   Planet @relation(fields: [planetId], references: [id])
  planetId String @map("planet_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("moons")
}

model Constellation {
  id            String  @id @default(uuid())
  name          String
  latinName     String? @map("latin_name")
  season        String?
  hemisphere    String?
  description   String?
  brightestStar String? @map("brightest_star")
  funFact       String? @map("fun_fact")
  starsCount    Int?    @map("stars_count")
  bestMonth     String? @map("best_month")
  imageUrl      String? @map("image_url")
  slug          String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("constellations")
}

model GalleryImage {
  id       String  @id @default(uuid())
  url      String?
  alt      String
  caption  String?
  featured Boolean @default(false)
  order    Int     @default(0)

  collection   GalleryCollection @relation(fields: [collectionId], references: [id])
  collectionId String            @map("collection_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gallery_images")
}

model GalleryCollection {
  id                 String  @id @default(uuid())
  title              String
  description        String
  rotationFrequency  String  @default("semanal") @map("rotation_frequency")

  images GalleryImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gallery_collections")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("ADMIN") // SUPERADMIN, ADMIN, EDITOR

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model ApplicationSubmission {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name")
  email        String
  area         String
  message      String
  portfolioUrl String?  @map("portfolio_url")
  status       String   @default("PENDING") // PENDING, REVIEWED, ACCEPTED, REJECTED

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("application_submissions")
}


