generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stat {
  id    String @id @default(uuid())
  value String
  label String
  order Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stats")
}

model NewsArticle {
  id                 String             @id @default(uuid())
  title              String
  summary            String
  imageUrl           String?            @map("image_url")
  date               DateTime
  readTimeMinutes    Int                @map("read_time_minutes")
  slug               String             @unique
  content            String?
  author             String?            @default("Equipo JEO")
  tags               String[]           @default([])
  coverImageCaption  String?            @map("cover_image_caption")
  status             String             @default("PUBLISHED")

  categories         Category[]         @relation("NewsArticleCategories")
  references         ArticleReference[]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([title])
  @@index([date(sort: Desc)])
  @@index([readTimeMinutes])
  @@index([status])
  @@index([status, date(sort: Desc)])
  @@index([tags], type: Gin)
  @@map("news_articles")
}

model Category {
  id          String        @id @default(uuid())
  name        String        @unique
  slug        String        @unique
  description String?

  articles    NewsArticle[] @relation("NewsArticleCategories")

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([name])
  @@map("categories")
}

model ArticleReference {
  id          String      @id @default(uuid())
  articleId   String      @map("article_id")
  article     NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title       String
  author      String?
  url         String?
  publisher   String?
  publishedAt DateTime?   @map("published_at")
  accessedAt  DateTime?   @map("accessed_at")

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([articleId])
  @@map("article_references")
}

model UniverseTab {
  id          String  @id @default(uuid())
  label       String
  slug        String  @unique
  description String?
  imageUrl    String? @map("image_url")
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("universe_tabs")
}

model Planet {
  id          String  @id @default(uuid())
  name        String  @unique
  imageUrl    String? @map("image_url")
  order       Int     @default(0)
  description String?
  slug        String  @unique

  moons Moon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("planets")
}

model Moon {
  id          String  @id @default(uuid())
  name        String
  imageUrl    String? @map("image_url")
  order       Int     @default(0)
  description String?
  slug        String  @unique

  planet   Planet @relation(fields: [planetId], references: [id])
  planetId String @map("planet_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("moons")
}

model Constellation {
  id            String  @id @default(uuid())
  name          String
  latinName     String? @map("latin_name")
  season        String?
  hemisphere    String?
  description   String?
  brightestStar String? @map("brightest_star")
  funFact       String? @map("fun_fact")
  starsCount    Int?    @map("stars_count")
  bestMonth     String? @map("best_month")
  imageUrl      String? @map("image_url")
  slug          String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("constellations")
}

model GalleryImage {
  id       String  @id @default(uuid())
  url      String?
  alt      String
  caption  String?
  featured Boolean @default(false)
  order    Int     @default(0)

  collection   GalleryCollection @relation(fields: [collectionId], references: [id])
  collectionId String            @map("collection_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gallery_images")
}

model GalleryCollection {
  id                 String  @id @default(uuid())
  title              String
  description        String
  rotationFrequency  String  @default("semanal") @map("rotation_frequency")

  images GalleryImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gallery_collections")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("ADMIN") // SUPERADMIN, ADMIN, EDITOR

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model ApplicationSubmission {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name")
  email        String
  area         String
  message      String
  portfolioUrl String?  @map("portfolio_url")
  status       String   @default("PENDING") // PENDING, REVIEWED, ACCEPTED, REJECTED

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("application_submissions")
}


