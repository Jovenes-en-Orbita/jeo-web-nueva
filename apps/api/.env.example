# NestJS API Environment Variables
PORT=3001
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="change-me-in-production"
CORS_ORIGIN="http://localhost:3000"
ALLOW_VERCEL_PREVIEWS="true"

# Neon S3-Compatible Object Storage
AWS_ENDPOINT_URL_S3="https://your-branch.storage.c-9.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_your_access_key"
AWS_SECRET_ACCESS_KEY="nsk_live_your_secret_key"
AWS_REGION="us-east-2"
AWS_S3_BUCKET="assets"
