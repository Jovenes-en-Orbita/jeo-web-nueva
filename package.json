{
  "name": "jeo-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @jeo/api exec prisma generate",
    "db:migrate": "pnpm --filter @jeo/api exec prisma migrate dev",
    "db:push": "pnpm --filter @jeo/api exec prisma db push",
    "db:seed": "pnpm --filter @jeo/api exec prisma db seed",
    "db:studio": "pnpm --filter @jeo/api exec prisma studio",
    "test": "turbo run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
